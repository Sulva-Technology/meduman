# --- Frontend (exposed to the browser via VITE_ prefix) ---
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Leave blank in dev to use the /api proxy. In prod set to the BARE NestJS
# origin — NO /api suffix and NO trailing slash, e.g. https://meduman-api.onrender.com
# The backend mounts every route at the root; a trailing "/api" here 404s all
# requests. The app throws a fail-fast error at boot if this is set wrong in prod.
VITE_API_BASE_URL=

# Public base URL used to build shareable links (pay page, invoices). Leave blank
# for https://meduman.sulvatech.com; set to a preview or localhost origin to test
# real links. No trailing slash.
VITE_APP_URL=

# --- Dev server only (not exposed to the browser) ---
# Where the Vite /api proxy forwards to. Must match the NestJS PORT.
API_PROXY_TARGET=http://localhost:3000

# --- Local Express (waitlist email) ---
# Port for npm run server / npm start; does not configure NestJS or Vite.
# Use a different port if NestJS is already running on 3000.
PORT=3000
# Configure Resend or SMTP below. Resend takes precedence when both are set.
# With neither RESEND_API_KEY nor SMTP_HOST, emails are logged to the console.
RESEND_API_KEY=
# Sender used by both providers; blank uses Meduman <no-reply@meduman.sulvatech.com>.
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
# 587 is the default; use 465 for implicit TLS.
SMTP_PORT=587
SMTP_USER=
